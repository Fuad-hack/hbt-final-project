# ITDT FastAPI Environment Configuration

# Database - using default postgres database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
DATABASE_SCHEMA=threat_detection

# Security
SECRET_KEY=your-secret-key-min-32-chars-for-jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Anomaly Thresholds
COMPOSITE_HIGH_THRESHOLD=0.55
COMPOSITE_MEDIUM_THRESHOLD=0.38

# Redis (for future Celery)
REDIS_URL=redis://localhost:6379/0

# Debug mode
DEBUG=False
